<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Space Puzzle: Cosmic Explorer | ส.ไก่ชนดาวอังคาร</title>
    <!-- Tailwind CSS for styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=Mitr:wght@400;500;600&display=swap" rel="stylesheet">
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --bg-color: #050a1f; /* Deep space blue/black */
            --primary-color: #3b82f6; /* Blue */
            --accent-color: #f59e0b; /* Star yellow */
            --text-color: #ffffff;
            --font-en: 'Inter', sans-serif;
            --font-th: 'Mitr', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: var(--font-en);
            overflow: hidden; /* Prevent scrolling, act like an app */
            background-image: 
                radial-gradient(circle at 15% 50%, rgba(255, 255, 255, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 85% 30%, rgba(59, 130, 246, 0.15) 0%, transparent 50%);
        }
        
        .lang-th {
            font-family: var(--font-th) !important;
        }

        /* Animated Stars Background */
        .stars {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: -1;
            pointer-events: none;
        }
        
        .star {
            position: absolute;
            background: white;
            border-radius: 50%;
            animation: twinkle infinite alternate;
        }

        @keyframes twinkle {
            0% { opacity: 0.2; transform: scale(0.8); }
            100% { opacity: 1; transform: scale(1.2); }
        }

        /* Floating elements */
        .float-anim {
            animation: floating 4s ease-in-out infinite;
        }

        @keyframes floating {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0px); }
        }

        /* Puzzle Elements */
        .draggable-item {
            cursor: grab;
            transition: transform 0.2s, box-shadow 0.2s;
            touch-action: none; /* Required for touch drag */
        }
        
        .draggable-item:active {
            cursor: grabbing;
            transform: scale(1.05);
            box-shadow: 0 10px 25px rgba(59, 130, 246, 0.5);
            z-index: 50;
        }

        .draggable-item.dragging {
            opacity: 0.7;
            transform: scale(1.1);
        }

        .drop-zone {
            transition: all 0.3s ease;
            border: 2px dashed rgba(255, 255, 255, 0.3);
        }

        .drop-zone.drag-over {
            background-color: rgba(59, 130, 246, 0.2);
            border-color: #3b82f6;
            transform: scale(1.02);
        }

        .drop-zone.correct {
            border: 2px solid #10b981; /* Green */
            background-color: rgba(16, 185, 129, 0.1);
            animation: pulse-green 1s;
        }
        
        .drop-zone.wrong {
            border: 2px solid #ef4444; /* Red */
            background-color: rgba(239, 68, 68, 0.1);
            animation: shake 0.5s;
        }

        @keyframes pulse-green {
            0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
            70% { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
            100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            50% { transform: translateX(5px); }
            75% { transform: translateX(-5px); }
        }

        /* Progress Bar */
        .progress-container {
            width: 100%;
            background-color: rgba(255, 255, 255, 0.1);
            border-radius: 9999px;
            overflow: hidden;
        }
        .progress-bar {
            height: 10px;
            background: linear-gradient(90deg, #3b82f6, #8b5cf6);
            width: 0%;
            transition: width 0.3s ease;
        }

        /* Hearts */
        .heart {
            color: #ef4444;
            transition: opacity 0.3s;
        }
        .heart.lost {
            opacity: 0.2;
            color: gray;
        }

        /* UI Overlays */
        .screen {
            display: none;
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background-color: rgba(5, 10, 31, 0.95);
            z-index: 100;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            backdrop-filter: blur(5px);
        }
        
        .screen.active {
            display: flex;
            animation: fadeIn 0.3s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        /* Custom Scrollbar for terms container if needed */
        .terms-container::-webkit-scrollbar {
            width: 6px;
        }
        .terms-container::-webkit-scrollbar-thumb {
            background-color: rgba(255,255,255,0.2);
            border-radius: 10px;
        }
        
        /* Glassmorphism cards */
        .glass-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 1rem;
        }
    </style>
</head>
<body class="h-screen w-screen relative select-none">

    <!-- Dynamic Stars Background Container -->
    <div id="stars-container" class="stars"></div>

    <!-- UI: Language & Audio Toggles (Always visible at top corners) -->
    <div class="absolute top-4 w-full px-6 flex justify-between items-center z-50">
        <button id="btn-lang" class="glass-card px-4 py-2 text-sm font-bold hover:bg-white/10 transition rounded-full shadow-lg">
            TH / EN
        </button>
        <button id="btn-sound" class="glass-card w-10 h-10 flex items-center justify-center rounded-full hover:bg-white/10 transition shadow-lg text-lg">
            <i class="fas fa-volume-up"></i>
        </button>
    </div>

    <!-- MAIN MENU SCREEN -->
    <div id="screen-start" class="screen active">
        <div class="text-center max-w-md w-full px-6">
            <div class="float-anim mb-6 text-6xl text-blue-400">
                <i class="fas fa-rocket"></i>
            </div>
            <h1 class="text-4xl md:text-5xl font-bold mb-2 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-500" data-i18n="title">
                Space Puzzle
            </h1>
            <p class="text-xl text-gray-300 mb-8 font-light" data-i18n="subtitle">
                (2)ppat ส.ไก่ชนดาวอังคาร
            </p>
            
            <div class="glass-card p-6 mb-8 text-left text-sm text-gray-300 space-y-3">
                <p><i class="fas fa-info-circle mr-2 text-blue-400"></i> <span data-i18n="instruction1">Drag and drop the correct space terms to their definitions.</span></p>
                <p><i class="fas fa-clock mr-2 text-blue-400"></i> <span data-i18n="instruction2">You have 60 seconds.</span></p>
                <p><i class="fas fa-heart mr-2 text-red-400"></i> <span data-i18n="instruction3">Wrong answers drain your energy (3 lives).</span></p>
                <p><i class="fas fa-star mr-2 text-yellow-400"></i> <span data-i18n="instruction4">Score > 80% to win!</span></p>
            </div>

            <button id="btn-start" class="w-full py-4 bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-500 hover:to-blue-400 rounded-full text-xl font-bold shadow-[0_0_15px_rgba(59,130,246,0.5)] transition transform hover:scale-105 active:scale-95 text-white">
                <i class="fas fa-play mr-2"></i> <span data-i18n="start">START GAME</span>
            </button>
        </div>
    </div>

    <!-- GAME SCREEN -->
    <div id="screen-game" class="screen bg-transparent pt-16 pb-4 px-4 md:px-8 flex-col justify-start">
        
        <!-- HUD (Heads Up Display) -->
        <div class="w-full max-w-4xl glass-card p-4 mb-4 flex justify-between items-center z-10 shadow-lg">
            <!-- Lives -->
            <div id="lives-container" class="flex space-x-1 text-xl md:text-2xl">
                <i class="fas fa-heart heart" id="heart-1"></i>
                <i class="fas fa-heart heart" id="heart-2"></i>
                <i class="fas fa-heart heart" id="heart-3"></i>
            </div>
            
            <!-- Timer & Score -->
            <div class="flex items-center space-x-4 md:space-x-8">
                <div class="text-center">
                    <div class="text-xs text-gray-400 uppercase tracking-wider" data-i18n="time">TIME</div>
                    <div class="text-xl md:text-2xl font-bold flex items-center">
                        <i class="fas fa-stopwatch mr-2 text-blue-400"></i>
                        <span id="timer-display">60</span>s
                    </div>
                </div>
                <div class="text-center">
                    <div class="text-xs text-gray-400 uppercase tracking-wider" data-i18n="score">SCORE</div>
                    <div class="text-xl md:text-2xl font-bold flex items-center text-yellow-400">
                        <i class="fas fa-star mr-2"></i>
                        <span id="score-display">0</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Progress Bar -->
        <div class="w-full max-w-4xl mb-4 z-10">
            <div class="progress-container">
                <div id="game-progress" class="progress-bar"></div>
            </div>
        </div>

        <!-- Gameplay Area -->
        <div class="flex-1 w-full max-w-4xl flex flex-col md:flex-row gap-4 overflow-hidden z-10">
            
            <!-- Draggable Items Container (The Terms) -->
            <div class="w-full md:w-1/3 glass-card p-4 flex flex-col h-1/3 md:h-full">
                <h2 class="text-center font-bold mb-4 text-blue-300 border-b border-blue-900/50 pb-2" data-i18n="terms">Terms</h2>
                <div id="terms-container" class="flex-1 overflow-y-auto terms-container flex flex-wrap md:flex-col gap-3 content-start">
                    <!-- Terms injected via JS -->
                </div>
            </div>

            <!-- Drop Zones Container (The Definitions) -->
            <div class="w-full md:w-2/3 glass-card p-4 flex flex-col h-2/3 md:h-full">
                <h2 class="text-center font-bold mb-4 text-purple-300 border-b border-purple-900/50 pb-2" data-i18n="definitions">Definitions / Characteristics</h2>
                <div id="definitions-container" class="flex-1 overflow-y-auto flex flex-col gap-4">
                    <!-- Definitions injected via JS -->
                </div>
            </div>
        </div>
    </div>

    <!-- RESULT SCREEN -->
    <div id="screen-result" class="screen">
        <div class="glass-card max-w-md w-full p-8 text-center shadow-[0_0_30px_rgba(59,130,246,0.3)]">
            
            <div id="result-icon" class="text-6xl mb-4 float-anim">
                <!-- Icon injected by JS (trophy or skull) -->
            </div>
            
            <h2 id="result-title" class="text-4xl font-bold mb-2"></h2>
            <p id="result-message" class="text-gray-300 mb-6"></p>
            
            <div class="bg-black/30 rounded-lg p-6 mb-8 flex justify-around">
                <div class="text-center">
                    <div class="text-sm text-gray-400 mb-1" data-i18n="finalScore">Score</div>
                    <div class="text-3xl font-bold text-yellow-400" id="final-score">0%</div>
                </div>
                <div class="text-center">
                    <div class="text-sm text-gray-400 mb-1" data-i18n="timeRemaining">Time Left</div>
                    <div class="text-3xl font-bold text-blue-400"><span id="final-time">0</span>s</div>
                </div>
            </div>

            <button id="btn-restart" class="w-full py-4 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 rounded-full text-xl font-bold shadow-lg transition transform hover:scale-105 active:scale-95 text-white">
                <i class="fas fa-redo mr-2"></i> <span data-i18n="playAgain">PLAY AGAIN</span>
            </button>
        </div>
    </div>


    <script>
        // Simple Audio Synthesizer for sound effects without external files
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        
        const sounds = {
            playTone: function(frequency, type, duration, vol=0.1) {
                if (!appState.soundOn) return;
                const oscillator = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();
                
                oscillator.type = type;
                oscillator.frequency.setValueAtTime(frequency, audioCtx.currentTime);
                
                gainNode.gain.setValueAtTime(vol, audioCtx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration);
                
                oscillator.connect(gainNode);
                gainNode.connect(audioCtx.destination);
                
                oscillator.start();
                oscillator.stop(audioCtx.currentTime + duration);
            },
            correct: () => {
                sounds.playTone(600, 'sine', 0.1, 0.2);
                setTimeout(() => sounds.playTone(800, 'sine', 0.2, 0.2), 100);
            },
            wrong: () => {
                sounds.playTone(200, 'sawtooth', 0.3, 0.2);
                setTimeout(() => sounds.playTone(150, 'sawtooth', 0.4, 0.2), 150);
            },
            grab: () => sounds.playTone(400, 'sine', 0.1, 0.05),
            drop: () => sounds.playTone(300, 'sine', 0.1, 0.05),
            win: () => {
                [523.25, 659.25, 783.99, 1046.50].forEach((freq, i) => {
                    setTimeout(() => sounds.playTone(freq, 'square', 0.3, 0.1), i * 150);
                });
            },
            lose: () => {
                [300, 280, 260, 200].forEach((freq, i) => {
                    setTimeout(() => sounds.playTone(freq, 'sawtooth', 0.4, 0.1), i * 300);
                });
            }
        };

        const GAME_DATA = [
            {
                id: 'sun',
                term: { en: 'Sun (Star)', th: 'ดวงอาทิตย์ (ดาวฤกษ์)' },
                desc: { en: 'The center of our solar system, generating heat and light via nuclear fusion.', th: 'ศูนย์กลางของระบบสุริยะ สร้างความร้อนและแสงสว่างด้วยปฏิกิริยานิวเคลียร์ฟิวชัน' },
                icon: 'fa-sun text-yellow-400'
            },
            {
                id: 'mercury',
                term: { en: 'Mercury', th: 'ดาวพุธ' },
                desc: { en: 'The smallest planet and closest to the Sun. It has extreme temperature variations.', th: 'ดาวเคราะห์ที่เล็กที่สุดและอยู่ใกล้ดวงอาทิตย์ที่สุด มีการเปลี่ยนแปลงอุณหภูมิที่รุนแรง' },
                icon: 'fa-circle text-gray-400'
            },
            {
                id: 'venus',
                term: { en: 'Venus', th: 'ดาวศุกร์' },
                desc: { en: 'The hottest planet in our solar system due to a dense, toxic atmosphere.', th: 'ดาวเคราะห์ที่ร้อนที่สุดในระบบสุริยะเนื่องจากชั้นบรรยากาศที่หนาแน่นและเป็นพิษ' },
                icon: 'fa-circle text-orange-300'
            },
            {
                id: 'earth',
                term: { en: 'Earth', th: 'โลก' },
                desc: { en: 'The only known planet to harbor life, with abundant liquid water.', th: 'ดาวเคราะห์ดวงเดียวที่รู้จักว่ามีสิ่งมีชีวิต มีน้ำในสถานะของเหลวอุดมสมบูรณ์' },
                icon: 'fa-globe-americas text-blue-400'
            },
            {
                id: 'mars',
                term: { en: 'Mars', th: 'ดาวอังคาร' },
                desc: { en: 'The "Red Planet", rusty iron dust covers its surface. Target for future exploration.', th: '"ดาวเคราะห์แดง" ฝุ่นเหล็กสนิมปกคลุมพื้นผิว เป็นเป้าหมายการสำรวจในอนาคต' },
                icon: 'fa-circle text-red-500'
            },
            {
                id: 'jupiter',
                term: { en: 'Jupiter', th: 'ดาวพฤหัสบดี' },
                desc: { en: 'The largest gas giant, known for its Great Red Spot (a giant storm).', th: 'ดาวเคราะห์แก๊สยักษ์ที่ใหญ่ที่สุด มีจุดแดงใหญ่ (พายุขนาดยักษ์) ที่โด่งดัง' },
                icon: 'fa-circle text-yellow-600'
            },
            {
                id: 'saturn',
                term: { en: 'Saturn', th: 'ดาวเสาร์' },
                desc: { en: 'Famous for its prominent, complex ring system made of ice and rock.', th: 'มีชื่อเสียงจากระบบวงแหวนที่ซับซ้อนและโดดเด่น ซึ่งประกอบด้วยน้ำแข็งและหิน' },
                icon: 'fa-ring text-yellow-200'
            },
            {
                id: 'moon',
                term: { en: 'Moon (Satellite)', th: 'ดวงจันทร์ (ดาวบริวาร)' },
                desc: { en: 'Earth\'s only natural satellite. Causes tides on Earth.', th: 'ดาวบริวารตามธรรมชาติเพียงดวงเดียวของโลก เป็นสาเหตุของการเกิดน้ำขึ้นน้ำลง' },
                icon: 'fa-moon text-gray-200'
            }
        ];

        const I18N = {
            en: {
                title: "Space Puzzle",
                subtitle: "(2)ppat ส.ไก่ชนดาวอังคาร",
                instruction1: "Drag and drop the correct space terms to their definitions.",
                instruction2: "You have 60 seconds.",
                instruction3: "Wrong answers drain your energy (3 lives).",
                instruction4: "Score > 80% to win!",
                start: "START GAME",
                time: "TIME",
                score: "SCORE",
                terms: "Space Terms",
                definitions: "Definitions / Characteristics",
                finalScore: "Final Score",
                timeRemaining: "Time Left",
                playAgain: "PLAY AGAIN",
                winTitle: "Mission Accomplished!",
                winMsg: "You have successfully mapped the cosmos.",
                loseTitle: "Mission Failed!",
                loseMsgTime: "You ran out of time. The universe remains a mystery.",
                loseMsgLife: "You lost all your energy. Critical failure.",
                loseMsgScore: "Score too low to qualify as an astronaut."
            },
            th: {
                title: "ปริศนาอวกาศ",
                subtitle: "(2)ppat ส.ไก่ชนดาวอังคาร",
                instruction1: "ลากและวางคำศัพท์อวกาศให้ตรงกับคำอธิบาย",
                instruction2: "คุณมีเวลา 60 วินาที",
                instruction3: "ตอบผิดจะเสียพลังงาน (มี 3 หัวใจ)",
                instruction4: "ทำคะแนนให้ได้มากกว่า 80% เพื่อชนะ!",
                start: "เริ่มเกม",
                time: "เวลา",
                score: "คะแนน",
                terms: "คำศัพท์อวกาศ",
                definitions: "คำอธิบาย / ลักษณะ",
                finalScore: "คะแนนรวม",
                timeRemaining: "เวลาที่เหลือ",
                playAgain: "เล่นใหม่",
                winTitle: "ภารกิจสำเร็จ!",
                winMsg: "คุณจัดทำแผนที่จักรวาลได้สำเร็จ ยอดเยี่ยมมาก",
                loseTitle: "ภารกิจล้มเหลว!",
                loseMsgTime: "หมดเวลา! จักรวาลยังคงเป็นปริศนาต่อไป",
                loseMsgLife: "พลังงานหมด! ยานอวกาศขัดข้อง",
                loseMsgScore: "คะแนนไม่ผ่านเกณฑ์การเป็นนักบินอวกาศ"
            }
        };

        let appState = {
            lang: localStorage.getItem('spacePuzzle_lang') || 'th',
            soundOn: localStorage.getItem('spacePuzzle_sound') !== 'false',
            highScore: parseInt(localStorage.getItem('spacePuzzle_highScore')) || 0
        };

        let gameState = {
            isPlaying: false,
            timeLeft: 60,
            lives: 3,
            score: 0,
            totalItems: GAME_DATA.length,
            correctItems: 0,
            timerId: null,
            currentLevelData: []
        };

        // DOM Elements
        const screens = {
            start: document.getElementById('screen-start'),
            game: document.getElementById('screen-game'),
            result: document.getElementById('screen-result')
        };
        
        const UI = {
            btnLang: document.getElementById('btn-lang'),
            btnSound: document.getElementById('btn-sound'),
            btnStart: document.getElementById('btn-start'),
            btnRestart: document.getElementById('btn-restart'),
            timerDisplay: document.getElementById('timer-display'),
            scoreDisplay: document.getElementById('score-display'),
            progressBar: document.getElementById('game-progress'),
            termsContainer: document.getElementById('terms-container'),
            definitionsContainer: document.getElementById('definitions-container'),
            hearts: [document.getElementById('heart-1'), document.getElementById('heart-2'), document.getElementById('heart-3')]
        };

        function initApp() {
            createStarsBackground();
            applyLanguage();
            applySoundSettings();
            
            // Event Listeners
            UI.btnLang.addEventListener('click', toggleLanguage);
            UI.btnSound.addEventListener('click', toggleSound);
            UI.btnStart.addEventListener('click', startGame);
            UI.btnRestart.addEventListener('click', startGame);
            
            // Touch/Mouse logic initialization is handled when terms are generated
        }

        function createStarsBackground() {
            const container = document.getElementById('stars-container');
            container.innerHTML = '';
            for (let i = 0; i < 100; i++) {
                const star = document.createElement('div');
                star.className = 'star';
                const size = Math.random() * 3 + 1;
                star.style.width = `${size}px`;
                star.style.height = `${size}px`;
                star.style.left = `${Math.random() * 100}%`;
                star.style.top = `${Math.random() * 100}%`;
                star.style.animationDuration = `${Math.random() * 3 + 2}s`;
                star.style.animationDelay = `${Math.random() * 2}s`;
                container.appendChild(star);
            }
        }

        function toggleLanguage() {
            appState.lang = appState.lang === 'th' ? 'en' : 'th';
            localStorage.setItem('spacePuzzle_lang', appState.lang);
            applyLanguage();
            if(gameState.isPlaying) {
                // Rerender UI if language changed mid-game
                renderGameContent();
            }
        }

        function applyLanguage() {
            document.body.className = `h-screen w-screen relative select-none ${appState.lang === 'th' ? 'lang-th' : ''}`;
            const dict = I18N[appState.lang];
            
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (dict[key]) {
                    el.innerText = dict[key];
                }
            });
            
            UI.btnLang.innerText = appState.lang === 'th' ? 'TH' : 'EN';
        }

        function toggleSound() {
            appState.soundOn = !appState.soundOn;
            localStorage.setItem('spacePuzzle_sound', appState.soundOn);
            applySoundSettings();
            // Resume Audio Context if blocked by browser policy
            if (appState.soundOn && audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        function applySoundSettings() {
            UI.btnSound.innerHTML = appState.soundOn ? '<i class="fas fa-volume-up"></i>' : '<i class="fas fa-volume-mute text-gray-500"></i>';
        }

        function switchScreen(screenId) {
            Object.values(screens).forEach(s => s.classList.remove('active'));
            screens[screenId].classList.add('active');
        }

        function startGame() {
            // Reset audio context to ensure it runs
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            
            gameState = {
                isPlaying: true,
                timeLeft: 60,
                lives: 3,
                score: 0,
                totalItems: GAME_DATA.length,
                correctItems: 0,
                timerId: null,
                currentLevelData: shuffleArray([...GAME_DATA])
            };
            
            updateHUD();
            resetHearts();
            renderGameContent();
            
            switchScreen('game');
            
            // Start Timer
            clearInterval(gameState.timerId);
            gameState.timerId = setInterval(updateTimer, 1000);
        }

        function shuffleArray(array) {
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
            return array;
        }

        function renderGameContent() {
            UI.termsContainer.innerHTML = '';
            UI.definitionsContainer.innerHTML = '';
            
            // Shuffle arrays independently for rendering
            const termsData = shuffleArray([...gameState.currentLevelData]);
            const descData = shuffleArray([...gameState.currentLevelData]);
            
            // Render Terms (Draggables)
            termsData.forEach(item => {
                // Skip if already solved
                if (item.solved) return;
                
                const termEl = document.createElement('div');
                termEl.className = 'draggable-item bg-gray-800/80 hover:bg-gray-700 border border-gray-600 rounded-lg p-3 text-center shadow font-semibold md:w-full w-[48%] flex items-center justify-center gap-2';
                termEl.draggable = true;
                termEl.dataset.id = item.id;
                termEl.innerHTML = `<i class="fas ${item.icon}"></i> <span>${item.term[appState.lang]}</span>`;
                
                // Desktop Drag Events
                termEl.addEventListener('dragstart', handleDragStart);
                termEl.addEventListener('dragend', handleDragEnd);
                
                // Mobile Touch Events (Custom Drag & Drop for Mobile)
                termEl.addEventListener('touchstart', handleTouchStart, {passive: false});
                termEl.addEventListener('touchmove', handleTouchMove, {passive: false});
                termEl.addEventListener('touchend', handleTouchEnd);
                
                UI.termsContainer.appendChild(termEl);
            });
            
            // Render Definitions (Drop Zones)
            descData.forEach(item => {
                const zoneContainer = document.createElement('div');
                zoneContainer.className = 'flex flex-col md:flex-row gap-2 items-stretch';
                
                const descEl = document.createElement('div');
                descEl.className = 'flex-1 bg-gray-900/50 border border-purple-900/50 rounded-lg p-3 text-sm flex items-center';
                descEl.innerText = item.desc[appState.lang];
                
                const dropZone = document.createElement('div');
                dropZone.className = 'drop-zone rounded-lg min-h-[50px] md:w-1/3 flex items-center justify-center p-2 text-xs text-gray-500';
                dropZone.dataset.id = item.id;
                
                if (item.solved) {
                    dropZone.classList.add('correct', 'border-solid');
                    dropZone.classList.remove('border-dashed');
                    dropZone.innerHTML = `<div class="text-green-400 font-bold flex items-center gap-2"><i class="fas ${item.icon}"></i> ${item.term[appState.lang]}</div>`;
                } else {
                    dropZone.innerText = appState.lang === 'th' ? 'วางที่นี่' : 'Drop here';
                    
                    // Desktop Drop Events
                    dropZone.addEventListener('dragover', handleDragOver);
                    dropZone.addEventListener('dragleave', handleDragLeave);
                    dropZone.addEventListener('drop', handleDrop);
                }
                
                zoneContainer.appendChild(descEl);
                zoneContainer.appendChild(dropZone);
                UI.definitionsContainer.appendChild(zoneContainer);
            });
        }

        let draggedElement = null;
        let touchClone = null; // For mobile dragging visual

        // Desktop Handlers
        function handleDragStart(e) {
            draggedElement = this;
            this.classList.add('dragging');
            e.dataTransfer.setData('text/plain', this.dataset.id);
            sounds.grab();
        }

        function handleDragEnd() {
            this.classList.remove('dragging');
            draggedElement = null;
        }

        function handleDragOver(e) {
            e.preventDefault(); // Necessary to allow dropping
            if (!this.classList.contains('correct')) {
                this.classList.add('drag-over');
            }
        }

        function handleDragLeave() {
            this.classList.remove('drag-over');
        }

        function handleDrop(e) {
            e.preventDefault();
            this.classList.remove('drag-over');
            const draggedId = e.dataTransfer.getData('text/plain');
            const targetId = this.dataset.id;
            
            checkMatch(draggedId, targetId, this);
        }

        // Mobile Touch Handlers
        function handleTouchStart(e) {
            if (e.target.closest('.draggable-item')) {
                // e.preventDefault();
                draggedElement = e.target.closest('.draggable-item');
                sounds.grab();
                
                // Create clone for dragging visual
                touchClone = draggedElement.cloneNode(true);
                touchClone.style.position = 'fixed';
                touchClone.style.zIndex = '1000';
                touchClone.style.opacity = '0.8';
                touchClone.style.width = draggedElement.offsetWidth + 'px';
                touchClone.style.pointerEvents = 'none'; // So elements underneath receive events
                document.body.appendChild(touchClone);
                
                moveTouchClone(e.touches[0].clientX, e.touches[0].clientY);
                draggedElement.style.opacity = '0.3';
            }
        }

        function handleTouchMove(e) {
            if (touchClone) {
                e.preventDefault(); // Prevent scrolling while dragging
                moveTouchClone(e.touches[0].clientX, e.touches[0].clientY);
                
                // Highlight drop zone under finger
                const elementsUnder = document.elementsFromPoint(e.touches[0].clientX, e.touches[0].clientY);
                const dropZone = elementsUnder.find(el => el.classList.contains('drop-zone') && !el.classList.contains('correct'));
                
                document.querySelectorAll('.drop-zone.drag-over').forEach(el => el.classList.remove('drag-over'));
                if (dropZone) {
                    dropZone.classList.add('drag-over');
                }
            }
        }

        function handleTouchEnd(e) {
            if (touchClone && draggedElement) {
                const changedTouch = e.changedTouches[0];
                const elementsUnder = document.elementsFromPoint(changedTouch.clientX, changedTouch.clientY);
                const dropZone = elementsUnder.find(el => el.classList.contains('drop-zone') && !el.classList.contains('correct'));
                
                document.querySelectorAll('.drop-zone.drag-over').forEach(el => el.classList.remove('drag-over'));
                
                if (dropZone) {
                    checkMatch(draggedElement.dataset.id, dropZone.dataset.id, dropZone);
                } else {
                    sounds.drop(); // Dropped outside
                }
                
                // Cleanup
                touchClone.remove();
                touchClone = null;
                draggedElement.style.opacity = '1';
                draggedElement = null;
            }
        }

        function moveTouchClone(x, y) {
            if(touchClone) {
                touchClone.style.left = (x - touchClone.offsetWidth / 2) + 'px';
                touchClone.style.top = (y - touchClone.offsetHeight / 2) + 'px';
            }
        }

        function checkMatch(draggedId, targetId, dropZoneElement) {
            if (draggedId === targetId) {
                // CORRECT MATCH
                sounds.correct();
                gameState.score += 100;
                gameState.correctItems++;
                
                // Mark item as solved in data
                const item = gameState.currentLevelData.find(i => i.id === targetId);
                item.solved = true;
                
                // Re-render UI to reflect changes
                renderGameContent();
                updateHUD();
                
                // Check win condition (All items matched)
                if (gameState.correctItems === gameState.totalItems) {
                    endGame(true, 'completed');
                }
            } else {
                // WRONG MATCH
                sounds.wrong();
                dropZoneElement.classList.add('wrong');
                setTimeout(() => dropZoneElement.classList.remove('wrong'), 500);
                
                loseLife();
            }
        }

        function loseLife() {
            gameState.lives--;
            UI.hearts[gameState.lives].classList.add('lost');
            
            if (gameState.lives <= 0) {
                endGame(false, 'life');
            }
        }

        function updateTimer() {
            if(!gameState.isPlaying) return;
            
            gameState.timeLeft--;
            updateHUD();
            
            // Warning sound at 10s
            if (gameState.timeLeft === 10) {
                UI.timerDisplay.parentElement.classList.add('text-red-500', 'animate-pulse');
            }
            
            if (gameState.timeLeft <= 0) {
                endGame(false, 'time');
            }
        }

        function updateHUD() {
            UI.timerDisplay.innerText = gameState.timeLeft;
            UI.scoreDisplay.innerText = gameState.score;
            
            // Progress Bar
            const percent = (gameState.correctItems / gameState.totalItems) * 100;
            UI.progressBar.style.width = `${percent}%`;
        }

        function resetHearts() {
            UI.hearts.forEach(h => h.classList.remove('lost'));
            UI.timerDisplay.parentElement.classList.remove('text-red-500', 'animate-pulse');
        }

        function endGame(isWin, reason) {
            gameState.isPlaying = false;
            clearInterval(gameState.timerId);
            
            const maxScore = gameState.totalItems * 100;
            const finalPercentage = (gameState.score / maxScore) * 100;
            const dict = I18N[appState.lang];
            
            // Logic for Winning (At least 80% required as per prompt)
            // Note: In this logic, if they match all, they get 100%. 
            // If time runs out, we check if they got >80%.
            let actualWin = false;
            if (isWin) {
                actualWin = true; // Completed all
            } else if (reason === 'time' && finalPercentage >= 80) {
                actualWin = true; // Ran out of time but got >= 80%
            }

            const rTitle = document.getElementById('result-title');
            const rMsg = document.getElementById('result-message');
            const rIcon = document.getElementById('result-icon');
            
            if (actualWin) {
                sounds.win();
                rTitle.innerText = dict.winTitle;
                rTitle.className = "text-4xl font-bold mb-2 text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-blue-500";
                rMsg.innerText = dict.winMsg;
                rIcon.innerHTML = '<i class="fas fa-trophy text-yellow-400"></i>';
                
                // Add time bonus
                if (gameState.timeLeft > 0) {
                    gameState.score += (gameState.timeLeft * 10);
                }
            } else {
                sounds.lose();
                rTitle.innerText = dict.loseTitle;
                rTitle.className = "text-4xl font-bold mb-2 text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-orange-500";
                
                if (reason === 'life') rMsg.innerText = dict.loseMsgLife;
                else if (reason === 'time') {
                    if (finalPercentage < 80 && finalPercentage > 0) rMsg.innerText = dict.loseMsgScore;
                    else rMsg.innerText = dict.loseMsgTime;
                }
                
                rIcon.innerHTML = '<i class="fas fa-skull-crossbones text-red-500"></i>';
            }
            
            document.getElementById('final-score').innerText = `${Math.round(finalPercentage)}% (${gameState.score})`;
            document.getElementById('final-time').innerText = gameState.timeLeft;
            
            // Save highscore
            if (gameState.score > appState.highScore) {
                appState.highScore = gameState.score;
                localStorage.setItem('spacePuzzle_highScore', appState.highScore);
            }
            
            switchScreen('result');
        }

        // Initialize on load
        window.onload = initApp;

    </script>
</body>
</html>
